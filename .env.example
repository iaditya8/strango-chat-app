NODE_ENV=production
PORT=4000
MAX_CONNECTIONS=2000

# Comma-separated browser origins allowed to open Socket.IO connections.
ALLOWED_ORIGINS=https://your-domain.com

# Required in production for /admin.html and /admin/*.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional clustered Socket.IO support.
# Requires Redis reachable from every app instance.
REDIS_URL=redis://localhost:6379

# Optional: enable Postgres-backed durable store (recommended for real production).
DATABASE_URL=postgres://user:password@localhost:5432/strango

# Optional: protect admin write endpoints in addition to Basic Auth.
ADMIN_API_TOKEN=replace-with-a-long-random-token

# HTTP rate limiting (requests/min per IP).
HTTP_RATE_LIMIT_PER_MIN=300

# Optional persistent JSON fallback path.
STRANGO_DATA_FILE=server/data/strango-state.json

# WebRTC ICE servers exposed to clients through /config/rtc.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:turn.your-domain.com:3478
TURN_USERNAME=replace-me
TURN_CREDENTIAL=replace-me
